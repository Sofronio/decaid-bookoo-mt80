{
  "id": "bookoo-mt80.reaplugin",
  "name": "Bookoo MT80 Grinder",
  "author": "Decaid contributors",
  "description": "Opt-in Bookoo MT80 grinder protocol using host-owned BLE.",
  "version": "0.2.0",
  "apiVersion": 1,
  "permissions": [
    "transport.ble",
    "api"
  ],
  "drivers": [
    {
      "id": "mt80",
      "type": "grinder",
      "capabilities": [
        "grindSetting",
        "rpmControl"
      ],
      "ble": {
        "match": {
          "name": {
            "contains": "mt80"
          }
        }
      },
      "controls": {
        "grindSetting": {
          "kind": "numeric",
          "min": 0,
          "max": 999,
          "step": 1
        },
        "rpmControl": {
          "kind": "numeric",
          "min": 500,
          "max": 1500,
          "step": 10
        }
      },
      "surfaces": [
        {
          "id": "settings",
          "role": "settings",
          "endpoint": "ui",
          "label": "MT80 controls"
        }
      ]
    }
  ],
  "settings": {},
  "api": [
    {
      "id": "ui",
      "type": "http",
      "data": {}
    }
  ]
}
